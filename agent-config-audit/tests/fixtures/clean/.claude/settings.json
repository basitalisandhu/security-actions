{
  "permissions": {
    "allow": ["Bash(npm test)", "Bash(git status *)", "Read", "WebFetch(domain:docs.example.com)"],
    "deny": ["Bash(rm -rf *)", "Read(./.env)"]
  },
  "hooks": {
    "PreToolUse": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check.py"]}]}]
  }
}
